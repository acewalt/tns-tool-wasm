{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acewalt.github.io/tns-tool-wasm/schemas/inspect-result.schema.json",
  "title": "TNS Tool WASM Inspect Result",
  "description": "Output shape for DOM-free TNS/XML document inspection.",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "input": { "type": "string" },
    "projectDir": { "type": ["string", "null"] },
    "temporaryProject": { "type": "boolean" },
    "summary": {
      "type": "object",
      "properties": {
        "xmlFileCount": { "type": "integer" },
        "luaScriptCount": { "type": "integer" },
        "files": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "luaScripts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "path": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "id": { "type": ["string", "null"] },
          "length": { "type": "integer" },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "required": ["success"],
  "additionalProperties": true
}
