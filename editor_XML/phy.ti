Prgm
Local opcion,seleccion,sub,dir,modo,sel

Local masa,peso,gravedad,fuerza,aceleracion,masa1,masa2,distancia,constanteg,desplazamiento,angulo,altura,velocidad,energiapotencial,energiacinetica,trabajo,fuerza1,fuerza2,fuerzaneta,vi,vf,emi

Local d,t,v,x,h,g,v0,a

clrio
Disp "                                                    "
Disp "                                                       "
Disp "                                                          "
Disp "                                                         "
Disp "                                                         "
Disp "                                                         "
Disp "                                                         "
Disp "1:Cinematica  2:Dinamica"
Disp "3:Energia/Trabajo  4:Gravitacion"
Disp "5:Conversion 6:Utilidades"
Request "op:",opcion
If opcion=1 Then

clrio

Disp "1:Velocidad"

Disp "2:MRUA  3:Caida libre"

Request "op:",seleccion



If seleccion=1 Then

Request "d(m):",d

Request "t(s):",t

If t=0 Then

Disp "Error"

Else

Disp "v=d/t"

Disp "v="&string(d)&" m/"&string(t)&" s"

approx(d/t)→velocidad

Disp "v="&string(velocidad)&" m/s"

EndIf

EndIf



If seleccion=2 Then

clrio
Disp "hallar:"
Disp "1(V) 2(X)po"
Disp "2(X)Po 3(a)"
Disp "4(t)con(v)"
Disp "5Sin(t)(v^2)"
Disp "6(t)sin(v)"

Request "op:",sel



If sel=1 Then

Disp "1:Reposo(v0=0)"

Disp "2:Con v0"

Request "op:",modo

If modo=1 Then

0→v0

Else

Request "(v0):",v0

EndIf

Request "(a):",a

Request "(t):",t

Disp "v=v0+a·t"

Disp "v="&string(v0)&" m/s+"&string(a)&" m/s^2·"&string(t)&" s"

approx(v0+a*t)→v

Disp "(v)="&string(v)&" m/s"

EndIf



If sel=2 Then

Disp "1:Reposo(v0=0)"

Disp "2:Con v0"

Request "op:",modo

If modo=1 Then

0→v0

Else

Request "(v0):",v0

EndIf

Request "(a):",a

Request "(t):",t

Disp "x=v0·t+1/2·a·t^2"

Disp "x="&string(v0)&" m/s·"&string(t)&" s+0.5·"&string(a)&" m/s^2·"&string(t)&"^2 s^2"

approx(v0*t+0.5*a*t^2)→x

Disp "(x)="&string(x)&" m"

EndIf



If sel=3 Then

Request "(v):",v

Disp "1:Reposo(v0=0)"

Disp "2:Con v0"

Request "op:",modo

If modo=1 Then

0→v0

Else

Request "(v0):",v0

EndIf

Request "(t):",t

If t=0 Then

Disp "Error"

Else

Disp "a=(v-v0)/t"

Disp "a=("&string(v)&" m/s-"&string(v0)&" m/s)/"&string(t)&" s"

approx((v-v0)/t)→a

Disp "(a)="&string(a)&" m/s^2"
EndIf
EndIf
If sel=4 Then

Request "(v):",v

Disp "1:Reposo(v0=0)"

Disp "2:Con v0"

Request "op:",modo

If modo=1 Then

0→v0

Else

Request "(v0):",v0

EndIf

Request "(a):",a

If a=0 Then

Disp "Error"

Else

Disp "t=(v-v0)/a"

Disp "t=("&string(v)&" m/s-"&string(v0)&" m/s)/"&string(a)&" m/s^2"

approx((v-v0)/a)→t

Disp "(t)="&string(t)&" s"

EndIf

EndIf



If sel=5 Then

clrio

Disp "1:Velocidad (v)"

Disp "2:Posicion (x)"

Request "op:",dir

If dir=1 Then

Disp "1:Reposo(v0=0)"

Disp "2:Con v0"

Request "op:",modo

If modo=1 Then

0→v0

Else

Request "(v0):",v0

EndIf

Request "(a):",a

Request "(x):",x

If v0^2+2*a*x<0 Then

Disp "Error"

Else

Disp "v^2=v0^2+2·a·x"

Disp "v=√("&string(v0)&"^2 (m/s)^2+2·"&string(a)&" m/s^2·"&string(x)&" m)"

Disp "v=√("&string(v0^2+2*a*x)&" m^2/s^2)"

approx(√(v0^2+2*a*x))→v

Disp "(v)="&string(v)&" m/s"

EndIf

EndIf

If dir=2 Then

Request "(v):",v

Disp "1:Reposo(v0=0)"

Disp "2:Con v0"

Request "op:",modo

If modo=1 Then

0→v0

Else

Request "(v0):",v0

EndIf

Request "(a):",a

If a=0 Then

Disp "Error"

Else

Disp "x=(v^2-v0^2)/(2a)"

Disp "x=("&string(v)&"^2 (m/s)^2-"&string(v0)&"^2 (m/s)^2)/(2·"&string(a)&" m/s^2)"

approx((v^2-v0^2)/(2*a))→x

Disp "(x)="&string(x)&" m"

EndIf

EndIf

EndIf



If sel=6 Then

Disp "1:Reposo(v0=0)"

Disp "2:Con v0"

Request "op:",modo

If modo=1 Then

0→v0

Else

Request "(v0):",v0

EndIf

Request "(a):",a

Request "(x):",x

If a=0 Then

Disp "Error"

Else

If v0^2+2*a*x<0 Then

Disp "Error"

Else

Disp "t=(-v0+√(v0^2+2·a·x))/a"

Disp "t=(-"&string(v0)&" m/s+√("&string(v0)&"^2 (m/s)^2+2·"&string(a)&" m/s^2·"&string(x)&" m))/"&string(a)&" m/s^2"

Disp "t=(-"&string(v0)&"+√("&string(v0^2+2*a*x)&"))/"&string(a)

approx((−v0+√(v0^2+2*a*x))/a)→t

Disp "(t)="&string(t)&" s"

EndIf

EndIf

EndIf

EndIf



If seleccion=3 Then

clrio

Disp "1:Sube (-)"

Disp "2:Baja (+)"

Request "op:",dir

If dir=1 Then

−9.8→g

Else

9.8→g

EndIf

clrio

Disp "1(v)Ve 2(h)Alt"""

Disp "3(t)con(v)"

Disp "4Sin(t)(v^2)"

Disp "5(t)sin(v)"

Request "op:",sel



If sel=1 Then

Disp "1:Reposo(v0=0)"

Disp "2:Con v0"

Request "op:",modo

If modo=1 Then

0→v0

Else

Request "(v0):",v0

EndIf

Request "(t):",t

Disp "v=v0+g·t"

Disp "v="&string(v0)&" m/s+"&string(g)&" m/s^2·"&string(t)&" s"

approx(v0+g*t)→v

Disp "(v)="&string(v)&" m/s"

EndIf



If sel=2 Then

Disp "1:Reposo(v0=0)"

Disp "2:Con v0"

Request "op:",modo

If modo=1 Then

0→v0

Else

Request "(v0):",v0

EndIf

Request "(t):",t

Disp "h=v0·t+1/2·g·t^2"

Disp "h="&string(v0)&" m/s·"&string(t)&" s+0.5·"&string(g)&" m/s^2·"&string(t)&"^2 s^2"

approx(v0*t+0.5*g*t^2)→h

Disp "(h)="&string(h)&" m"

EndIf



If sel=3 Then

Request "(v):",v

Disp "1:Reposo(v0=0)"

Disp "2:Con v0"

Request "op:",modo

If modo=1 Then

0→v0

Else

Request "(v0):",v0

EndIf

Disp "t=(v-v0)/g"

Disp "t=("&string(v)&" m/s-"&string(v0)&" m/s)/"&string(g)&" m/s^2"

approx((v-v0)/g)→t

Disp "(t)="&string(t)&" s"

EndIf



If sel=4 Then

clrio

Disp "1:(v)Velocidad"

Disp "2:(h)Altura"

Request "op:",dir

If dir=1 Then

Disp "1:Reposo(v0=0)"

Disp "2:Con v0"

Request "op:",modo

If modo=1 Then

0→v0

Else

Request "(v0):",v0

EndIf

Request "(h):",h

If v0^2+2*g*h<0 Then

Disp "Error"

Else

Disp "v^2=v0^2+2·g·h"

Disp "v=√("&string(v0)&"^2 (m/s)^2+2·"&string(g)&" m/s^2·"&string(h)&" m)"

Disp "v=√("&string(v0^2+2*g*h)&" m^2/s^2)"

approx(√(v0^2+2*g*h))→v

Disp "(v)="&string(v)&" m/s"

EndIf

EndIf

If dir=2 Then

Request "(v):",v

Disp "1:Reposo(v0=0)"

Disp "2:Con v0"

Request "op:",modo

If modo=1 Then

0→v0

Else

Request "(v0):",v0

EndIf

Disp "h=(v^2-v0^2)/(2g)"

Disp "h=("&string(v)&"^2 (m/s)^2-"&string(v0)&"^2 (m/s)^2)/(2·"&string(g)&" m/s^2)"

approx((v^2-v0^2)/(2*g))→h

Disp "(h)="&string(h)&" m"

EndIf

EndIf



If sel=5 Then

Disp "1:Reposo(v0=0)"

Disp "2:Con v0"

Request "op:",modo

If modo=1 Then

0→v0

Else

Request "(v0)velocidad inicial:",v0

EndIf

Request "(h)altura:",h

If g=0 Then

Disp "Error"

Else

If v0^2+2*g*h<0 Then

Disp "Error"

Else

Disp "t=(-v0+√(v0^2+2·g·h))/g"

Disp "t=(-"&string(v0)&" m/s+√("&string(v0)&"^2 (m/s)^2+2·"&string(g)&" m/s^2·"&string(h)&" m))/"&string(g)&" m/s^2"

Disp "t=(-"&string(v0)&"+√("&string(v0^2+2*g*h)&"))/"&string(g)

approx((−v0+√(v0^2+2*g*h))/g)→t

Disp "(t)="&string(t)&" s"

EndIf

EndIf

EndIf

EndIf

EndIf



If opcion=2 Then

clrio

Disp "1:(Inercia)"

Disp "2:(F=m·a)"

Disp "3:(Accion-Reacc)"

Disp "4:(P=m·g)Peso "

Disp "5:Equilibrio (ΣF=0)"

Disp "6:Fuerza neta (ΣF=F1-F2)"

Request "op:",seleccion



If seleccion=1 Then

Disp "1ra ley de Newton"

Disp "Si ΣF=0"

Disp "mantiene estado"

EndIf



If seleccion=2 Then

clrio

Disp "1:(N)Fuerza"

Disp "2:(m)Masa"

Disp "3:(a)Aceleracion"

Request "op:",sub

If sub=1 Then

Request "(Kg)Masa:",masa

Request "(a)ace(m/s^2):",aceleracion

Disp "F=m·a"

Disp "F="&string(masa)&" kg·"&string(aceleracion)&" m/s^2"

approx(masa*aceleracion)→fuerza

Disp "F="&string(fuerza)&" N"

EndIf

If sub=2 Then

Request "(N)Fuerza:",fuerza

Request "(a)Ace (m/s^2):",aceleracion

If aceleracion=0 Then

Disp "Error"

Else

Disp "m=F/a"

Disp "m=("&string(fuerza)&" N)/("&string(aceleracion)&" m/s^2)"

approx(fuerza/aceleracion)→masa

Disp "m="&string(masa)&" kg"

EndIf

EndIf

If sub=3 Then

Request "Fuerza (N):",fuerza

Request "Masa (kg):",masa

If masa=0 Then

Disp "Error"

Else

Disp "a=F/m"

Disp "a=("&string(fuerza)&" N)/("&string(masa)&" kg)"

approx(fuerza/masa)→aceleracion

Disp "a="&string(aceleracion)&" m/s^2"

EndIf

EndIf

EndIf



If seleccion=3 Then

Disp "3ra ley de Newton"

Disp "Accion-Reaccion"

Disp "F12=-F21"

EndIf



If seleccion=4 Then

9.8→gravedad

clrio

Disp "1:(N)Calcular peso"

Disp "2:(Kg)Calcular masa"

Request "op:",sub

If sub=1 Then

Request "(Kg)Masa:",masa

Disp "W=m·g"

Disp "W=("&string(masa)&" kg)·(9.8 m/s^2)"

approx(masa*9.8)→peso

Disp "W="&string(peso)&" N"

EndIf

If sub=2 Then

Request "(N)Peso:",peso

Disp "m=W/g"

Disp "m=("&string(peso)&" N)/(9.8 m/s^2)"

approx(peso/(9.8))→masa

Disp "m="&string(masa)&" kg"

EndIf

EndIf



If seleccion=5 Then

Request "F1:",fuerza1

Request "F2:",fuerza2

Disp "ΣF=F1-F2"

Disp "ΣF=("&string(fuerza1)&" N)-("&string(fuerza2)&" N)"

approx(fuerza1-fuerza2)→fuerzaneta

Disp "Fn="&string(fuerzaneta)&" N"

If fuerzaneta=0 Then

Disp "Equilibrio"

Else

Disp "No equilibrio"

EndIf

EndIf
If seleccion=6 Then

Request "F1:",fuerza1

Request "F2:",fuerza2

Disp "Fn=F1-F2"

Disp "Fn=("&string(fuerza1)&" N)-("&string(fuerza2)&" N)"

approx(fuerza1-fuerza2)→fuerzaneta

Disp "Fn="&string(fuerzaneta)&" N"

EndIf

EndIf



If opcion=3 Then

clrio

Disp "1:T"
Disp "2: Y(Ep)   3: X (Ec)"
Disp "4:Cambio de Ec (ΔEc)  5:Energia mec (Em)"

Disp "6:Conservacion de ener 7:Relacion v-h"
Request "op:",seleccion

If seleccion=1 Then

clrio

Disp "1:Sin angulo = T"

Disp "2:Con angulo = T"

Request "op:",sub

If sub=1 Then

Request "(N)Fuerza:",fuerza

Request "(m)Distancia:",desplazamiento

Disp "T=F·d"

Disp "T=("&string(fuerza)&" N)·("&string(desplazamiento)&" m)"

approx(fuerza*desplazamiento)→trabajo

Disp "T="&string(trabajo)&" J"

EndIf

If sub=2 Then

Request "(N)Fuerza:",fuerza

Request "(m)Distancia:",desplazamiento

Request "Angulo (°):",angulo

Disp "T=F·d·cosθ"

Disp "T=("&string(fuerza)&" N)·("&string(desplazamiento)&" m)·cos("&string(angulo)&"°)"

approx(cos(angulo*π/180))→aceleracion

Disp "cos("&string(angulo)&"°)="&string(aceleracion)

approx(fuerza*desplazamiento)→trabajo

Disp "T=("&string(trabajo)&" N·m)·("&string(aceleracion)&")"

approx(trabajo*aceleracion)→trabajo

Disp "T="&string(trabajo)&" J"

EndIf

EndIf

If seleccion=2 Then

Disp "1:Sube (-)"

Disp "2:Baja (+)"

Request "op:",dir

If dir=1 Then

−9.8→gravedad

Else

9.8→gravedad

EndIf

Request "Masa (kg):",masa

Request "Altura (m):",altura

Disp "Ep=m·g·h"

Disp "Ep=("&string(masa)&" kg)·("&string(gravedad)&" m/s^2)·("&string(altura)&" m)"

approx(gravedad*altura)→aceleracion

Disp "Ep=("&string(masa)&" kg)·("&string(aceleracion)&" m^2/s^2)"

approx(masa*aceleracion)→energiapotencial

Disp "Ep="&string(energiapotencial)&" J"

EndIf

If seleccion=3 Then

Request "Masa (kg):",masa

Request "Velocidad (m/s):",velocidad

Disp "Ec=1/2·m·v^2"

Disp "Ec=(0.5)·("&string(masa)&" kg)·("&string(velocidad)&" m/s)^2"

approx(velocidad^2)→aceleracion

Disp "Ec=(0.5)·("&string(masa)&" kg)·("&string(aceleracion)&" m^2/s^2)"

approx(0.5*masa*aceleracion)→energiacinetica

Disp "Ec="&string(energiacinetica)&" J"

EndIf

If seleccion=4 Then

Request "Masa (kg):",masa

Request "Vi (m/s):",vi

Request "Vf (m/s):",vf

Disp "ΔEc=1/2·m(vf^2-vi^2)"

Disp "ΔEc=(0.5)·("&string(masa)&" kg)·(("&string(vf)&" m/s)^2-("&string(vi)&" m/s)^2)"

approx(vf^2-vi^2)→aceleracion

Disp "ΔEc=(0.5)·("&string(masa)&" kg)·("&string(aceleracion)&" m^2/s^2)"

approx(0.5*masa*aceleracion)→trabajo

Disp "ΔEc="&string(trabajo)&" J"

EndIf

If seleccion=5 Then

Request "Ec (J):",energiacinetica

Request "Ep (J):",energiapotencial

Disp "Em=Ec+Ep"

Disp "Em=("&string(energiacinetica)&" J)+("&string(energiapotencial)&" J)"

approx(energiacinetica+energiapotencial)→emi

Disp "Em="&string(emi)&" J"

EndIf

If seleccion=6 Then

Request "Em (J):",emi

Request "Ep (J):",energiapotencial

Disp "Ec=Em-Ep"

Disp "Ec=("&string(emi)&" J)-("&string(energiapotencial)&" J)"

approx(emi-energiapotencial)→energiacinetica

Disp "Ec="&string(energiacinetica)&" J"

EndIf

If seleccion=7 Then

clrio

Disp "1:(v)desde(h)"

Disp "2:(h)desde(v)"

Request "op:",sub

If sub=1 Then

Disp "1:Sube (-)"

Disp "2:Baja (+)"

Request "op:",dir

If dir=1 Then

−9.8→g

Else

9.8→g

EndIf

Request "(h)altura:",altura

If 2*g*altura<0 Then

Disp "Error"

Else

Disp "v=√(2·g·h)"

Disp "v=√(2·("&string(g)&" m/s^2)·("&string(altura)&" m))"

Disp "v=√("&string(2*g*altura)&" m^2/s^2)"

approx(√(2*g*altura))→velocidad

Disp "v="&string(velocidad)&" m/s"

EndIf

EndIf

If sub=2 Then

Disp "1:Sube (-)"

Disp "2:Baja (+)"

Request "op:",dir

If dir=1 Then

−9.8→g

Else

9.8→g

EndIf

Request "v:",velocidad

If g=0 Then

Disp "Error"

Else

Disp "h=v^2/(2g)"

Disp "h=("&string(velocidad)&" m/s)^2/(2·("&string(g)&" m/s^2))"

approx(velocidad^2/(2*g))→altura

Disp "h="&string(altura)&" m"

EndIf

EndIf

EndIf

EndIf



If opcion=4 Then

6.67*e-11→constanteg

Request "Masa1 (kg):",masa1

Request "Masa2 (kg):",masa2

Request "Distancia (m):",distancia

If distancia=0 Then

Disp "Error"

Else

Disp "F=G·m1·m2/r^2"

Disp "F=("&string(constanteg)&")·("&string(masa1)&" kg)·("&string(masa2)&" kg)/("&string(distancia)&" m)^2"

approx(constanteg*masa1*masa2/distancia^2)→fuerza

Disp "F="&string(fuerza)&" N"

EndIf

EndIf



If opcion=5 Then

clrio

Disp "1:kmh->ms"

Disp "2:ms->kmh"

Request "op:",seleccion

If seleccion=1 Then

Request "v:",velocidad

Disp "m/s=(km/h)/3.6"

Disp "v="&string(velocidad)&" km/h·(1000 m/1 km)·(1 h/3600 s)"

Disp "v="&string(velocidad)&"/3.6"

approx(velocidad/(3.6))→velocidad

Disp "v="&string(velocidad)&" m/s"

EndIf

If seleccion=2 Then

Request "v:",velocidad

Disp "km/h=(m/s)·3.6"

Disp "v="&string(velocidad)&" m/s·(3600 s/1 h)·(1 km/1000 m)"

Disp "v="&string(velocidad)&"·3.6"

approx(velocidad*3.6)→velocidad

Disp "v="&string(velocidad)&" km/h"

EndIf

EndIf



If opcion=6 Then

clrio

Disp "1:Constantes"

Disp "2:Ayuda"

Request "op:",seleccion

If seleccion=1 Then

Disp "g=9.8 m/s^2"

Disp "G=6.67E-11"

EndIf

If seleccion=2 Then

Disp "v=d/t"

Disp "v=v0+a·t"

Disp "x=v0·t+1/2·a·t^2"

Disp "F=m·a"

Disp "W=m·g"

Disp "Ep=m·g·h"

Disp "Ec=1/2·m·v^2"

EndIf

EndIf
EndPrgm